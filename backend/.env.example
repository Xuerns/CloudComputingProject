# Konfigurasi Server
HOST=0.0.0.0
PORT=8000

# Identitas Server Lokal Anggota (Ubah sesuai pembagian: m0 / m1 / m2 / m3 / m4)
MEMBER_ROUTE=m1

# ==============================================================================
# PILIHAN DATABASE (PILIH SALAH SATU):
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCALHOST XAMPP (MySQL / MariaDB) - AKTIFKAN INI UNTUK TUGAS LOKAL
#    Pastikan modul MySQL di XAMPP Control Panel sudah 'Start'
#    dan database sudah diimport dari sql/schema_mysql.sql di phpMyAdmin.
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kelompok_db

# ------------------------------------------------------------------------------
# 2. SUPABASE (Cloud PostgreSQL) - KOMENTARI JIKA PAKAI LOCAL XAMPP
#    Jika ingin pakai Supabase: hapus '#' pada DATABASE_URL di bawah ini
#    (dan bisa kosongkan/komentari variabel DB_* di atas).
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/postgres
