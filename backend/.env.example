# Konfigurasi Server
HOST=0.0.0.0
PORT=8000

# Identitas Server Lokal Anggota (Ubah sesuai pembagian: m0 / m1 / m2 / m3 / m4)
MEMBER_ROUTE=m0

# Database URL (PostgreSQL / Supabase Transaction Pooler Port 6543)
DATABASE_URL=postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/postgres

# Opsi manual jika tidak menggunakan full URL:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=kelompok_db
